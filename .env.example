# Server Configuration
PORT=8080
NODE_ENV=development

# Google Gemini API Key (Required for live AI interaction analysis & guidance)
# If left empty, CareCompass automatically falls back to intelligent clinical mock guidance
GEMINI_API_KEY=

# Caretaker Default Passcode
CARETAKER_PASSCODE=9876
ELDERLY_PIN=1234

# Nodemailer / SMTP Configuration
# If left empty, CareCompass automatically generates an Ethereal Email test inbox and provides live preview URLs
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
NOTIFICATION_EMAIL=caretaker@carecompass-demo.com

